# Postgres connection string. Added automatically when you connect a Neon database
# to the Vercel project (Storage tab). Either name works.
DATABASE_URL=

# Shared access code people type on the sign-in screen.
APP_PASSCODE=

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Local development only: set to "memory" to run without a database.
# STORE=memory
