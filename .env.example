# ---- Sign-in ----
# Shared access code people type on the sign-in screen.
APP_PASSCODE=
# Random string of 32+ characters used to sign the sign-in cookie.
SESSION_SECRET=

# ---- Storage: GitHub (used automatically when GITHUB_TOKEN is set) ----
# Fine-grained personal access token with Contents: Read and write on the data repo only.
GITHUB_TOKEN=
# The repository that holds the data, written as owner/repo-name.
# Use a separate private repo, not the code repo (see README).
GITHUB_REPO=
# Branch to save to. Defaults to main.
GITHUB_BRANCH=main
# Folder inside the repo. Defaults to data.
GITHUB_DATA_PATH=data

# ---- Storage: Postgres (optional, only if you switch later) ----
# STORE=postgres
# DATABASE_URL=

# ---- Local development only ----
# STORE=memory
